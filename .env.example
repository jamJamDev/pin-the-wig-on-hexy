# Copy this file to .env (which is gitignored) and paste your tunnel token.
#
# Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> Install connector:
# copy ONLY the token (the long string after `--token`) into the value below.
# Do NOT commit .env. Rotate the token from the dashboard if it ever leaks.
TUNNEL_TOKEN=

# Secret that gates the operator broadcast (flash a message over every player's
# screen). Leave blank to disable broadcasting entirely -- with no token set,
# the server refuses every publish. Send messages with scripts/broadcast.sh (run
# it with no arguments for an interactive menu). Use a long random value, e.g.
# `openssl rand -hex 24`. Never commit the real .env.
PTWOH_ADMIN_TOKEN=

# Where scripts/broadcast.sh sends messages -- the game's public base URL. The
# production stack is tunnel-only (no published host port), so localhost can't
# reach the API; point this at your live host. Defaults to https://hexy.obju.red;
# override per-run with `broadcast.sh --url https://...`.
PTWOH_BROADCAST_URL=https://hexy.obju.red
